---
// 1. Get props from the parent page
const { t, hasProjects, hasExperience, hasEducation } = Astro.props;
---

<header
  id="header"
  class="fixed top-0 text-sm sm:text-xl left-0 right-0 z-50 block transition-all duration-300 backdrop-blur-sm bg-[linear-gradient(to_bottom,rgba(255,255,255,0.8),rgba(255,255,255,0))] dark:bg-[linear-gradient(to_bottom,rgba(3,7,18,0.8),rgba(3,7,18,0))]"
>
  <nav class="max-w-7xl mx-auto px-2 py-4">
    <ul class="flex items-center gap-5 sm:gap-6 justify-center">
      <li>
        <a
          href="#about"
          class="text-gray-700 dark:text-gray-300 hover:text-black dark:hover:text-white transition-colors font-medium"
        >
          {t.about} <!-- Use translation -->
        </a>
      </li>
      {
        hasProjects && (
          <li>
            <a
              href="#projects"
              class="text-gray-700 dark:text-gray-300 hover:text-black dark:hover:text-white transition-colors font-medium"
            >
              {t.projects}
            </a>
          </li>
        )
      }
      {
        hasExperience && (
          <li>
            <a
              href="#experience"
              class="text-gray-700 dark:text-gray-300 hover:text-black dark:hover:text-white transition-colors font-medium"
            >
              {t.experience} <!-- Use translation -->
            </a>
          </li>
        )
      }
      {
        hasEducation && (
          <li>
            <a
              href="#education"
              class="text-gray-700 dark:text-gray-300 hover:text-black dark:hover:text-white transition-colors font-medium"
            >
              {t.education} <!-- Use translation -->
            </a>
          </li>
        )
      }
      <li>
        <!-- Theme toggle button -->
        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          class="p-1.5 rounded-lg text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        >
          <!-- Sun icon — shown in dark mode -->
          <svg
            id="icon-sun"
            xmlns="http://www.w3.org/2000/svg"
            class="hidden dark:block h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
          <!-- Moon icon — shown in light mode -->
          <svg
            id="icon-moon"
            xmlns="http://www.w3.org/2000/svg"
            class="block dark:hidden h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Theme toggle handler
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const html = document.documentElement;

    // Force all elements to transition at the same speed during the flip
    html.classList.add("theme-transitioning");
    const isDark = html.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    setTimeout(() => html.classList.remove("theme-transitioning"), 350);
  });

  // Update header background when theme changes (for when user is already scrolled)
  const observer = new MutationObserver(() => {
    const header = document.getElementById("header");
    if (!header) return;
    // The .scrolled class is managed by the main scroll script;
    // just ensure the CSS picks up the current dark/light state automatically.
  });
  observer.observe(document.documentElement, { attributeFilter: ["class"] });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
