---
// 1. Import your new utilities
import { getTranslations } from "../../i18n/utils";
import type { Translations } from "../../i18n/utils";
import { siteConfig } from "../../config"; // This is the smaller, static config

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

// 2. Get the current language's translations
const t = getTranslations(Astro.currentLocale);

// 3. Define props for components that need data
const hasProjects = t.projects.items && t.projects.items.length > 0;
const hasExperience = t.experience.items && t.experience.items.length > 0;
const hasEducation = t.education.items && t.education.items.length > 0;
const baseUrl = "https://jpgp.es";
const locale = Astro.currentLocale === "es" ? "es" : "en";
const canonicalUrl = locale === "es" ? `${baseUrl}/es/` : `${baseUrl}/`;

// Import components
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import About from "../../components/About.astro";
import Projects from "../../components/Projects.astro";
import Experience from "../../components/Experience.astro";
import Education from "../../components/Education.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
---

<!-- 4. Set the lang attribute dynamically -->
<html lang={Astro.currentLocale || "en"}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{t.site.seoTitle}</title>
    <meta name="description" content={t.site.seoDescription} />
    <meta name="keywords" content={t.site.keywords} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={t.site.ogTitle} />
    <meta property="og:description" content={t.site.ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.site.ogTitle} />
    <meta name="twitter:description" content={t.site.ogDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Theme initialisation (must run before first paint to prevent flash) -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V3YEJ0MGBF"></script>
    <script is:inline lang="ts">
      // @ts-ignore
      window.dataLayer = window.dataLayer || [];
      // @ts-ignore
      function gtag() {
        dataLayer.push(arguments);
      }
      // @ts-ignore
      gtag("js", new Date());
      // @ts-ignore
      gtag("config", "G-V3YEJ0MGBF");
    </script>
    <!-- End Google Analytics -->
  </head>

  <body>
    <!-- 6. Pass translations and config down as props -->
    <Header
      t={t.nav}
      hasProjects={hasProjects}
      hasExperience={hasExperience}
      hasEducation={hasEducation}
    />
    <main id="main">
      <Hero
        t={t.hero}
        siteName={t.site.name}
        accentColor={siteConfig.accentColor}
        social={siteConfig.social}
      />
      <About
        t={t.about}
        skills={t.skills}
        skillsTitle={t.skills_title}
        accentColor={siteConfig.accentColor}
      />
      <Projects
        t={t.projects}
        accentColor={siteConfig.accentColor}
        hasProjects={hasProjects}
      />
      <Experience
        t={t.experience}
        accentColor={siteConfig.accentColor}
        hasExperience={hasExperience}
      />
      <Education
        t={t.education}
        accentColor={siteConfig.accentColor}
        hasEducation={hasEducation}
      />
      <Footer
        t={t.nav}
        siteName={t.site.name}
        siteTitle={t.site.title}
        social={siteConfig.social}
        copyright={t.footer.copyright}
        accentColor={siteConfig.accentColor}
        hasProjects={hasProjects}
        hasExperience={hasExperience}
        hasEducation={hasEducation}
      />
    </main>
    <script is:inline>
      // A. Define parameters for what we consider a "Desktop" environment
      // We'll use the pointer/hover check AND a screen width check for safety.
      const isDesktopPointer = window.matchMedia(
        "(hover: hover) and (pointer: fine)",
      ).matches;

      // Max width (in pixels) we'll consider a "phone" or small device
      const MAX_MOBILE_WIDTH = 768;
      const isLargeScreen = window.innerWidth > MAX_MOBILE_WIDTH;

      // Final determination: Must have desktop-like pointer AND be a large screen
      const isDesktop = isDesktopPointer && isLargeScreen;

      const body = document.body;
      const main = document.getElementById("main");

      if (isDesktop) {
        // --- DESKTOP SMOOTH SCROLL LOGIC (Only runs if both checks pass) ---

        // 1. Activate smooth scroll styles
        body.classList.add("smooth-scroll-active");

        let sx = 0,
          sy = 0;
        let dx = sx,
          dy = sy;

        // Linear interpolation function
        function li(a, b, n) {
          return (1 - n) * a + n * b;
        }

        // Adjust body height to allow native scrolling to happen
        function updateBodyHeight() {
          // Use CSS variable to set body height based on main's content size
          document.documentElement.style.setProperty(
            "--main-scroll-height",
            `${main.scrollHeight}px`,
          );
        }

        // ResizeObserver fires on ANY size change to <main>: window resize,
        // font load reflow, image load, dynamic content — all covered.
        // This fixes the "can't reach the bottom on first load" bug caused by
        // custom fonts reflowing the page taller after the initial measurement.
        const ro = new ResizeObserver(updateBodyHeight);
        ro.observe(main);

        // Also re-measure once fonts are fully loaded (belt-and-suspenders)
        document.fonts.ready.then(updateBodyHeight);

        // Capture actual scroll position
        window.addEventListener("scroll", () => {
          sx = window.pageXOffset;
          sy = window.pageYOffset;
        });

        // Animation loop
        function render() {
          // Smoothly interpolate the tracked scroll position (sx, sy) to the rendered position (dx, dy)
          dx = li(dx, sx, 0.07);
          dy = li(dy, sy, 0.07);

          // Snap to exact target when very close — prevents asymptotic drift that
          // stops the footer from being fully visible at the bottom of the page.
          if (Math.abs(dx - sx) < 0.5) dx = sx;
          if (Math.abs(dy - sy) < 0.5) dy = sy;

          // Apply the transform to the main content
          main.style.transform = `translate3d(-${dx}px, -${dy}px, 0)`;

          // Update header based on scroll position
          const header = document.getElementById("header");
          if (header) {
            if (dy > 100) {
              header.classList.add("backdrop-blur-sm", "scrolled");
            } else {
              header.classList.remove("backdrop-blur-sm", "scrolled");
            }
          }

          requestAnimationFrame(render);
        }

        requestAnimationFrame(render);
      } else {
        // --- MOBILE/NON-DESKTOP FAILSAFE ---
        // If the check fails, ensure all smooth-scroll-related styling is off.

        // 1. Remove the smooth scroll class just in case the browser applied it for some reason
        body.classList.remove("smooth-scroll-active");

        // 2. Clear any lingering inline styles that conflict with native scrolling
        // This is the most important part of the failsafe.
        main.style.transform = "";
        document.documentElement.style.removeProperty("--main-scroll-height");
        body.style.removeProperty("height");

        // 3. Optional: Set main back to natural flow if any other external CSS tries to fix it.
        main.style.position = "static";
      }

      // --- ANCHOR LINK HANDLER (Works for both mobile and desktop) ---
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener("click", (e) => {
          const targetId = link.getAttribute("href").substring(1);
          const target = document.getElementById(targetId);
          if (target) {
            e.preventDefault();
            window.scrollTo({
              top: target.offsetTop,
              behavior: "smooth",
            });
          }
        });
      });
    </script>
  </body>
</html>
